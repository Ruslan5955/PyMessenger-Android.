<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0b141a"> <!-- Глубокий темный фон -->

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="vertical"
            android:gravity="center"
            android:maxWidth="400dp">

            <!-- Логотип проекта -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🦁"
                android:textSize="85sp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIFE AND LION"
                android:textColor="#FFD700"
                android:textSize="30sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Secure Cloud Messenger"
                android:textColor="#6a7c85"
                android:textSize="13sp"
                android:layout_marginBottom="44dp" />

            <!-- Стильное круглое поле телефона -->
            <EditText
                android:id="@+id/phoneInput"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:hint="Номер телефона"
                android:textColorHint="#6a7c85"
                android:textColor="#e9edef"
                android:inputType="phone"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:background="@drawable/rounded_input"
                android:layout_marginBottom="16dp"
                android:textSize="16sp"
                android:maxLines="1" />

            <!-- Стильное круглое поле пароля -->
            <EditText
                android:id="@+id/passwordInput"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:hint="Пароль"
                android:textColorHint="#6a7c85"
                android:textColor="#e9edef"
                android:inputType="textPassword"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:background="@drawable/rounded_input"
                android:layout_marginBottom="32dp"
                android:textSize="16sp"
                android:maxLines="1" />

            <!-- Трендовая круглая кнопка ВОЙТИ -->
            <Button
                android:id="@+id/loginButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Войти"
                android:textColor="#0b141a"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/rounded_button"
                android:stateListAnimator="@null" /> <!-- Убираем топорные тени 2000-х -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Защищено сквозным шифрованием"
                android:textColor="#2f3b43"
                android:textSize="12sp"
                android:layout_marginTop="40dp" />

        </LinearLayout>
    </RelativeLayout>
</ScrollView>
