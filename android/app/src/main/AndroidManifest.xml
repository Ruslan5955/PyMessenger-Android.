<manifest xmlns:android="http://android.com" package="com.messenger.pro">
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:label="PyMessenger Pro" android:theme="@android:style/Theme.NoTitleBar.Fullscreen" android:usesCleartextTraffic="true">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
